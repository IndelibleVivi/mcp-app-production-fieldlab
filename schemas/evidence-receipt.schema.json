{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldlab.invalid/schemas/evidence-receipt@1",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "mcp-app-fieldlab-receipt@1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "revision"],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["verified", "failed", "not_verified"]
        },
        "method_rung": {
          "type": "string",
          "enum": [
            "source",
            "process",
            "artifact",
            "activated-runtime",
            "named-host",
            "owner"
          ]
        },
        "proof_ceiling": {
          "type": "string",
          "enum": [
            "source",
            "process",
            "artifact",
            "activated-runtime",
            "named-host",
            "owner"
          ]
        },
        "not_verified_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["text", "status", "method_rung", "proof_ceiling"],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_dirty": {
          "type": "boolean"
        },
        "resource": {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string",
              "pattern": "^ui:\\/\\/.*"
            },
            "mime_type": {
              "type": "string",
              "const": "text/html;profile=mcp-app"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["uri", "mime_type", "bytes", "sha256"],
          "additionalProperties": false
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtime_identity": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "source-inspection",
            "local-process",
            "local-browser-harness",
            "clean-package",
            "isolated-runtime",
            "activated-runtime",
            "named-host",
            "owner-observation"
          ]
        },
        "host_profile": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["class"],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "discovery": {
          "type": "string",
          "enum": ["missing", "available", "denied", "unknown"]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "not_attempted",
            "absent",
            "success",
            "rejected",
            "cancelled",
            "policy_denied",
            "technical_failure",
            "unknown"
          ]
        }
      },
      "required": ["discovery", "disposition"],
      "additionalProperties": false
    },
    "root_cause_confidence": {
      "type": "string",
      "enum": ["confirmed", "probable", "unknown"]
    },
    "observations": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_proven": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "format",
    "generated_at",
    "scenario",
    "claim",
    "subject",
    "environment",
    "observations",
    "evidence_refs",
    "limitations",
    "not_proven"
  ],
  "additionalProperties": false
}
