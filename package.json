{
  "name": "mcp-app-production-fieldlab",
  "version": "0.1.0-private.0",
  "private": true,
  "description": "Executable MCP App production boundary laboratory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IndelibleVivi/mcp-app-production-fieldlab.git"
  },
  "homepage": "https://github.com/IndelibleVivi/mcp-app-production-fieldlab#readme",
  "type": "module",
  "scripts": {
    "build": "skybridge build && node scripts/assert-build.mjs",
    "check": "npm run validate:register && npm run validate:schemas && npm run validate:scenarios && npm run typecheck && npm run test && npm run build && npm run test:mcp",
    "dev": "skybridge dev",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "package:runtime": "node scripts/package-runtime.mjs",
    "schemas:write": "tsx scripts/generate-schemas.ts",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "start": "skybridge start",
    "test": "vitest run --maxWorkers=2",
    "test:host": "npm run build && playwright test",
    "test:mcp": "tsx scripts/mcp-smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "validate:register": "node scripts/validate-register.mjs",
    "validate:scenarios": "tsx scripts/validate-scenarios.ts",
    "validate:schemas": "tsx scripts/generate-schemas.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "skybridge": "1.4.0",
    "vite": "7.3.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@skybridge/devtools": "1.4.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22.23.1"
  }
}
